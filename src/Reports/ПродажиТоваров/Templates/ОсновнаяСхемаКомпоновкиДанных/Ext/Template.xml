		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СправочникНоменклатура.Ссылка КАК Номенклатура,
	ПродажиОбороты.Клиент КАК Клиент,
	ЕСТЬNULL(ПродажиОбороты.КоличествоОборот, 0) КАК Количество,
	ЕСТЬNULL(ПродажиОбороты.ВыручкаОборот, 0) КАК Выручка
ИЗ
	Справочник.Номенклатура КАК СправочникНоменклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Продажи.Обороты КАК ПродажиОбороты
		ПО (ПродажиОбороты.Номенклатура = СправочникНоменклатура.Ссылка)
ГДЕ
	СправочникНоменклатура.ЭтоГруппа = ЛОЖЬ
	И СправочникНоменклатура.ПометкаУдаления = ЛОЖЬ</query>
	</dataSet>
