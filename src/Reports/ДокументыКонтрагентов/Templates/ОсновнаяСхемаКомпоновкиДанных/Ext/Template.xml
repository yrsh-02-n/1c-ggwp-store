		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ПоступлениеТоваров.Ссылка КАК Документ,
	ПоступлениеТоваров.Номер КАК Номер,
	ПоступлениеТоваров.Дата КАК Дата
ИЗ
	Документ.ПоступлениеТоваров КАК ПоступлениеТоваров
ГДЕ
	ПоступлениеТоваров.Проведен = ИСТИНА
	И ПоступлениеТоваров.Контрагент = &amp;Контрагент

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	РеализацияТоваров.Ссылка,
	РеализацияТоваров.Номер,
	РеализацияТоваров.Дата
ИЗ
	Документ.РеализацияТоваров КАК РеализацияТоваров
ГДЕ
	РеализацияТоваров.Проведен = ИСТИНА
	И РеализацияТоваров.Контрагент = &amp;Контрагент

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗаказТоваров.Ссылка,
	ЗаказТоваров.Номер,
	ЗаказТоваров.Дата
ИЗ
	Документ.ЗаказТоваров КАК ЗаказТоваров
ГДЕ
	ЗаказТоваров.Проведен = ИСТИНА
	И ЗаказТоваров.Контрагент = &amp;Контрагент

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	СчетНаОплату.Ссылка,
	СчетНаОплату.Номер,
	СчетНаОплату.Дата
ИЗ
	Документ.СчетНаОплату КАК СчетНаОплату
ГДЕ
	СчетНаОплату.Проведен = ИСТИНА
	И СчетНаОплату.Контрагент = &amp;Контрагент

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ОказаниеУслуг.Ссылка,
	ОказаниеУслуг.Номер,
	ОказаниеУслуг.Дата
ИЗ
	Документ.ОказаниеУслуг КАК ОказаниеУслуг
ГДЕ
	ОказаниеУслуг.Проведен = ИСТИНА
	И ОказаниеУслуг.Контрагент = &amp;Контрагент</query>
