Функция НайтиЯчейкуСОстатком(Склад, ТаблицаТоваров, Дата) Экспорт
	// Список номенклатуры
	СписокНоменклатуры = Новый СписокЗначений;
	
	Для Каждого Строка Из ТаблицаТоваров Цикл
	    Если СписокНоменклатуры.НайтиПоЗначению(Строка.Номенклатура) = Неопределено Тогда
	        СписокНоменклатуры.Добавить(Строка.Номенклатура);
	    КонецЕсли;
	КонецЦикла;
	
	// Запрос
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОстаткиНоменклатурыОстатки.Ячейка КАК Ячейка,
	               |	ОстаткиНоменклатурыОстатки.КоличествоОстаток КАК КоличествоОстаток,
	               |	ОстаткиНоменклатурыОстатки.Номенклатура КАК Номенклатура
	               |ИЗ
	               |	РегистрНакопления.ОстаткиНоменклатуры.Остатки(
	               |			&Дата,
	               |			Номенклатура В (&СписокНоменклатуры)
	               |				И Склад = &Склад
	               |				И Ячейка <> &ПустаяЯчейка) КАК ОстаткиНоменклатурыОстатки
	               |ГДЕ
	               |	ОстаткиНоменклатурыОстатки.КоличествоОстаток > 0";       
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("СписокНоменклатуры", СписокНоменклатуры);
	Запрос.УстановитьПараметр("ПустаяЯчейка", Справочники.Ячейки.ПустаяСсылка());
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПроверитьИЗаполнитьЯчейки(ТаблицаТоваров, Склад, Дата, ИмяКолонкиЯчейки) Экспорт
	
	// Получаем все ячейки, где есть товар
	ТаблицаЯчеек = НайтиЯчейкуСОстатком(Склад, ТаблицаТоваров, Дата);
	
	// Цикл проверки
	Для Каждого Строка Из ТаблицаТоваров Цикл
		
		// Если ячейка не указана - подставляем найденную
		Если НЕ ЗначениеЗаполнено(Строка[ИмяКолонкиЯчейки]) Тогда
			Найденная = ТаблицаЯчеек.Найти(Строка.Номенклатура, "Номенклатура");
			
			Если Найденная <> Неопределено Тогда
				Строка[ИмяКолонкиЯчейки] = Найденная.Ячейка;
			Иначе
				Сообщить("Не найдено ячейки с остатком для товара " + Строка.Номенклатура);
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
		
		// Проверяем остаток в ячейке
		ТаблицаОстатков = ПолучитьОстаткиПоЯчейке(Склад, ТаблицаТоваров, Строка[ИмяКолонкиЯчейки], Дата);
		СтрокаОстатка = ТаблицаОстатков.Найти(Строка.Номенклатура, "Номенклатура");
		Остаток = ?(СтрокаОстатка = Неопределено, 0, СтрокаОстатка.КоличествоОстаток);
		
		Если Остаток < Строка.Количество Тогда
			Сообщить("В ячейке " + Строка[ИмяКолонкиЯчейки] + " не хватает " + Строка.Номенклатура + " в количестве " + (Строка.Количество - Остаток));
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;	
КонецФункции