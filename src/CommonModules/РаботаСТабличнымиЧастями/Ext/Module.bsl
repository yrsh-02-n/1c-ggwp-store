   Процедура СвернутьТовары(ТабличнаяЧасть, ДопКолонки = "") Экспорт
	
	// Базовые колонки для группировки
	КолонкиГруппировки = "Номенклатура, Цена, ЕдиницаИзмерения, ВидНоменклатуры, СтавкаНДС";
	
	// Если переданы дополнительные колонки — добавляем
	Если ПустаяСтрока(ДопКолонки) = Ложь Тогда
		КолонкиГруппировки = КолонкиГруппировки + ", " + ДопКолонки;
	КонецЕсли;
	
	// Сворачиваем
	ТабличнаяЧасть.Свернуть(КолонкиГруппировки, "Количество, СуммаНДС");	
	// Пересчитываем сумму и заново считаем НДС
	Для каждого Строка Из ТабличнаяЧасть Цикл
        // сумма без НДС
		Строка.Сумма = Строка.Количество * Строка.Цена;
        
        // Пересчитываем НДС
		Если ЗначениеЗаполнено(Строка.СтавкаНДС) И НЕ РаботаСНДС.СтавкаНеОблагается(Строка.СтавкаНДС) Тогда
            Строка.СуммаНДС = РаботаСНДС.РассчитатьНДС(Строка.Сумма, Строка.СтавкаНДС);
        Иначе
            Строка.СуммаНДС = 0;
        КонецЕсли;
        
        // Итоговая сумма с НДС
        Строка.Сумма = Строка.Сумма + Строка.СуммаНДС;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСтрокуТовары(Строка) Экспорт
    // Считает сумму и НДС для строки
    Строка.Сумма = Строка.Количество * Строка.Цена;
    
    Если ЗначениеЗаполнено(Строка.СтавкаНДС) И НЕ РаботаСНДС.СтавкаНеОблагается(Строка.СтавкаНДС) Тогда
        Строка.СуммаНДС = РаботаСНДС.РассчитатьНДС(Строка.Сумма, Строка.СтавкаНДС);
    Иначе
        Строка.СуммаНДС = 0;
    КонецЕсли;
    
    Строка.Сумма = Строка.Сумма + Строка.СуммаНДС;
КонецПроцедуры  

&НаКлиенте
Функция ПолучитьИтогиПоДокументу(Таблица) Экспорт
    СуммаИтого = 0;
    СуммаНДСИтого = 0;
    
    Для каждого Строка Из Таблица Цикл
        СуммаИтого = СуммаИтого + Строка.Сумма;
        СуммаНДСИтого = СуммаНДСИтого + Строка.СуммаНДС;
    КонецЦикла;
    
    Возврат Новый Структура("СуммаИтого, СуммаНДСИтого", СуммаИтого, СуммаНДСИтого);
КонецФункции