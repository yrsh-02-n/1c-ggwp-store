Процедура РассчитатьСтрокуТовары(Строка) Экспорт
    // Считает сумму и НДС для строки
    Строка.Сумма = Строка.Количество * Строка.Цена;
    
    Если ЗначениеЗаполнено(Строка.СтавкаНДС) И НЕ РаботаСНДС.СтавкаНеОблагается(Строка.СтавкаНДС) Тогда
        Строка.СуммаНДС = РаботаСНДС.РассчитатьНДС(Строка.Сумма, Строка.СтавкаНДС);
    Иначе
        Строка.СуммаНДС = 0;
    КонецЕсли;
    
    Строка.Сумма = Строка.Сумма + Строка.СуммаНДС;
КонецПроцедуры