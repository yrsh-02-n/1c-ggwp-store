Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)   
	РаботаСФормами.УстановитьТекущуюДату(ЭтотОбъект);
	
	// Проверка ячейки
	Если РаботаСОстатками.ПроверитьИЗаполнитьЯчейки(ТабНоменклатура, Склад, Дата, "Ячейка") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;

КонецПроцедуры  

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		// Заполнение шапки
		Договор = ДанныеЗаполнения.Договор;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Организация = ДанныеЗаполнения.Организация;
		СуммаИтого = ДанныеЗаполнения.СуммаИтого;
		Для Каждого ТекСтрокаТабНоменклатура Из ДанныеЗаполнения.ТабНоменклатура Цикл
			Если ТекСтрокаТабНоменклатура.Номенклатура.ВидНоменклатуры =
			Перечисления.ВидыНоменклатуры.Товар Тогда
				НоваяСтрока = ТабНоменклатура.Добавить();
				НоваяСтрока.ЕдиницаИзмерения = ТекСтрокаТабНоменклатура.ЕдиницаИзмерения;
				НоваяСтрока.Количество = ТекСтрокаТабНоменклатура.Количество;
				НоваяСтрока.Номенклатура = ТекСтрокаТабНоменклатура.Номенклатура;
				НоваяСтрока.ВидНоменклатуры = ТекСтрокаТабНоменклатура.ВидНоменклатуры;
				НоваяСтрока.Сумма = ТекСтрокаТабНоменклатура.Сумма;
				НоваяСтрока.Цена = ТекСтрокаТабНоменклатура.Цена; 
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)   
	
	// регистр ОстаткиНоменклатуры Приход и расход
	Движения.ОстаткиНоменклатуры.Записывать = Истина; 
	
	Для Каждого ТекСтрока Из ТабНоменклатура Цикл
        ДвижениеРасход = Движения.ОстаткиНоменклатуры.Добавить();
        ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Расход;
        ДвижениеРасход.Период = Дата;
        ДвижениеРасход.Организация = Организация;
        ДвижениеРасход.Склад = Склад; 
		ДвижениеРасход.Ячейка = ТекСтрока.Ячейка;
        ДвижениеРасход.Номенклатура = ТекСтрока.Номенклатура;
        ДвижениеРасход.Количество = ТекСтрока.Количество;
     КонецЦикла;

КонецПроцедуры



