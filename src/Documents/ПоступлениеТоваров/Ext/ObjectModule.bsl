
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказТоваров") Тогда
		// Заполнение шапки
		Договор = ДанныеЗаполнения.Договор;
		Контрагент = ДанныеЗаполнения.Контрагент;
		Организация = ДанныеЗаполнения.Организация;
		СуммаИтого = ДанныеЗаполнения.СуммаИтого;
		Для Каждого ТекСтрокаТабНоменклатура Из ДанныеЗаполнения.ТабНоменклатура Цикл
			НоваяСтрока = ТабНоменклатура.Добавить();
			НоваяСтрока.Количество = ТекСтрокаТабНоменклатура.Количество;
			НоваяСтрока.Номенклатура = ТекСтрокаТабНоменклатура.Номенклатура;
			НоваяСтрока.Сумма = ТекСтрокаТабНоменклатура.Сумма;
			НоваяСтрока.Цена = ТекСтрокаТабНоменклатура.Цена; 
			НоваяСтрока.ВидНоменклатуры = ТекСтрокаТабНоменклатура.ВидНоменклатуры;    
			НоваяСтрока.ЕдиницаИзмерения = ТекСтрокаТабНоменклатура.ЕдиницаИзмерения;
		КонецЦикла;
	КонецЕсли;  
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    // Пересчитываем ВСЕ строки
    Для Каждого ТекСтрока Из ТабНоменклатура Цикл
        Если ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
            
            Если НЕ ЗначениеЗаполнено(ТекСтрока.СтавкаНДС) Тогда
                ТекСтрока.СтавкаНДС = РаботаСНДС.ПолучитьСтавкуНДС(ТекСтрока.Номенклатура);
            КонецЕсли;
            
            РаботаСТабличнымиЧастямиСервер.РассчитатьСтрокуТовары(ТекСтрока);
        КонецЕсли;
    КонецЦикла;
    
	РаботаСТабличнымиЧастями.СвернутьТовары(ТабНоменклатура);
    
    // Пересчитываем итоги
        СуммаИтого = 0;
    СуммаНДСИтого = 0;
    Для Каждого ТекСтрока Из ТабНоменклатура Цикл
        СуммаИтого = СуммаИтого + ТекСтрока.Сумма;
        СуммаНДСИтого = СуммаНДСИтого + ТекСтрока.СуммаНДС;
    КонецЦикла;
    
    ЭтотОбъект.СуммаИтого = СуммаИтого;
    ЭтотОбъект.СуммаНДСИтого = СуммаНДСИтого;
КонецПроцедуры 

Процедура ОбработкаПроведения(Отказ, Режим)
	//{{__КОНСТРУКТОР_ДВИЖЕНИЙ_РЕГИСТРОВ
