Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)  
	РаботаСФормами.УстановитьТекущуюДату(ЭтотОбъект);
	
	// Заполнены ли ячейки
	Для Каждого ТекСтрока Из ТабНоменклатура Цикл 
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ЯчейкаОтправитель)
			ИЛИ НЕ ЗначениеЗаполнено(ТекСтрока.ЯчейкаПолучатель) Тогда
			Отказ = Истина;
			Сообщить("Есть незаполненные ячейки!");
			Возврат;
		КонецЕсли;
		
		// Проверка на одинаковую ячейку 
		Если ТекСтрока.ЯчейкаОтправитель = ТекСтрока.ЯчейкаПолучатель Тогда
		    Отказ = Истина;
		    Сообщить("Отправитель и получатель не должны совпадать!");
		    Возврат;
		КонецЕсли;
	КонецЦикла;
	
	// Проверка остатка в ячейке
	Если РаботаСОстатками.ПроверитьИЗаполнитьЯчейки(ТабНоменклатура, Склад, Дата, "ЯчейкаОтправитель") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры  

Процедура ОбработкаПроведения(Отказ, Режим)  
	Движения.ОстаткиНоменклатуры.Записывать = Истина;

	Для Каждого ТекСтрока Из ТабНоменклатура Цикл
        // Расход с ячейки-отправителя
        ДвижениеРасход = Движения.ОстаткиНоменклатуры.Добавить();
        ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Расход;
        ДвижениеРасход.Период = Дата;
        ДвижениеРасход.Организация = Организация;
        ДвижениеРасход.Склад = Склад;
		ДвижениеРасход.Ячейка = ТекСтрока.ЯчейкаОтправитель;
        ДвижениеРасход.Номенклатура = ТекСтрока.Номенклатура;
        ДвижениеРасход.Количество = ТекСтрока.Количество;
        
        // Приход на ячейку-получателя
        ДвижениеПриход = Движения.ОстаткиНоменклатуры.Добавить();
        ДвижениеПриход.ВидДвижения = ВидДвиженияНакопления.Приход;
        ДвижениеПриход.Период = Дата;
        ДвижениеПриход.Организация = Организация;
        ДвижениеПриход.Склад = Склад; 
		ДвижениеПриход.Ячейка = ТекСтрока.ЯчейкаПолучатель;
        ДвижениеПриход.Номенклатура = ТекСтрока.Номенклатура; 
        ДвижениеПриход.Количество = ТекСтрока.Количество;
	КонецЦикла;
	
КонецПроцедуры
