Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)  
	РаботаСФормами.УстановитьТекущуюДату(ЭтотОбъект);
	
	// Проверка на разные склады
	Если СкладОтправитель = СкладПолучатель Тогда
		Отказ = Истина;
		Сообщить("Склады-отправитель и склад-получатель не должны совпадать");
		Возврат
	КонецЕсли;  
	
	// Проверка ячейки
	Если РаботаСОстатками.ПроверитьИЗаполнитьЯчейки(ТабНоменклатура, СкладОтправитель, Дата, "ЯчейкаОтправитель") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	// Если приемка не найдена
	ЯчейкаПриемкиПолучателя = РаботаСОстатками.ПолучитьЯчейкуПриемки(СкладПолучатель);
	
	Если НЕ ЗначениеЗаполнено(ЯчейкаПриемкиПолучателя) Тогда
		Отказ = Истина;
		Сообщить("На складе-получателе не найдена ячейка Приемка!");
		Возврат;
	КонецЕсли;
	
	// регистр ОстаткиНоменклатуры Приход и расход
	Движения.ОстаткиНоменклатуры.Записывать = Истина; 
	
	Для Каждого ТекСтрока Из ТабНоменклатура Цикл
        // Расход со склада-отправителя
        ДвижениеРасход = Движения.ОстаткиНоменклатуры.Добавить();
        ДвижениеРасход.ВидДвижения = ВидДвиженияНакопления.Расход;
        ДвижениеРасход.Период = Дата;
        ДвижениеРасход.Организация = Организация;
        ДвижениеРасход.Склад = СкладОтправитель; 
		ДвижениеРасход.Ячейка = ТекСтрока.ЯчейкаОтправитель;
        ДвижениеРасход.Номенклатура = ТекСтрока.Номенклатура;
        ДвижениеРасход.Количество = ТекСтрока.Количество;
        
        // Приход на склад-получатель
        ДвижениеПриход = Движения.ОстаткиНоменклатуры.Добавить();
        ДвижениеПриход.ВидДвижения = ВидДвиженияНакопления.Приход;
        ДвижениеПриход.Период = Дата;
        ДвижениеПриход.Организация = Организация;
        ДвижениеПриход.Склад = СкладПолучатель; 
		ДвижениеПриход.Ячейка = ЯчейкаПриемкиПолучателя;
        ДвижениеПриход.Номенклатура = ТекСтрока.Номенклатура; 
        ДвижениеПриход.Количество = ТекСтрока.Количество;
	КонецЦикла;
	
КонецПроцедуры
