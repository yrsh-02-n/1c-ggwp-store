&НаКлиенте
Процедура ПересчетТЧ(Элемент)
    ТекСтрока = Элементы.ТабНоменклатура.ТекущиеДанные;
    Если ТекСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    РаботаСТабличнымиЧастями.РассчитатьСтрокуТовары(ТекСтрока);
    ПересчитатьИтогиИПропись();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВсеСтроки()
    Для каждого Строка Из Объект.ТабНоменклатура Цикл
        // Пересчитываем цену
        Если ЗначениеЗаполнено(Строка.Номенклатура) Тогда
            Строка.Цена = РаботаСЦеной.ЦенаПродажи(
                Объект.Дата,
                Объект.Организация,
                Строка.Номенклатура
            );
        КонецЕсли;
        
        // Подтягиваем ставку
        Если НЕ ЗначениеЗаполнено(Строка.СтавкаНДС) И ЗначениеЗаполнено(Строка.Номенклатура) Тогда
            Строка.СтавкаНДС = РаботаСНДС.ПолучитьСтавкуНДС(Строка.Номенклатура);
        КонецЕсли;
        
        // Считаем строку
        РаботаСТабличнымиЧастями.РассчитатьСтрокуТовары(Строка);
    КонецЦикла;
    
    ПересчитатьИтогиИПропись();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогиИПропись()
    Итоги = РаботаСТабличнымиЧастями.ПолучитьИтогиПоДокументу(Объект.ТабНоменклатура);
    Объект.СуммаИтого = Итоги.СуммаИтого;
    Объект.СуммаНДСИтого = Итоги.СуммаНДСИтого;
    
    СуммаИтогоПрописью = ИтогИСумма.ИтоговоеЧислоПрописью(Объект.СуммаИтого);
КонецПроцедуры

&НаСервере
Функция ПолучениеЕдиницаИзмерения(Номенклатура)
	Возврат Номенклатура.ЕдиницаИзмерения;
КонецФункции

&НаСервере
Функция ПолучениеВидНоменклатуры(Номенклатура)
	Возврат Номенклатура.ВидНоменклатуры;
КонецФункции

&НаКлиенте
Процедура ТабНоменклатураНоменклатураПриИзменении(Элемент)  
	// Проверяем, есть ли строки в табличной части
    Если Объект.ТабНоменклатура.Количество() = 0 Тогда
        Возврат;
	КонецЕсли;
	
	ТекСтрока = Элементы.ТабНоменклатура.ТекущиеДанные;
	ТекСтрока.ЕдиницаИзмерения = ПолучениеЕдиницаИзмерения(ТекСтрока.Номенклатура); 
	ТекСтрока.ВидНоменклатуры = ПолучениеВидНоменклатуры(ТекСтрока.Номенклатура);
	ТекСтрока.Цена = РаботаСЦеной.ЦенаПродажи(Объект.Дата,Объект.Организация,ТекСтрока.Номенклатура);
	ТекСтрока.СтавкаНДС = РаботаСНДС.ПолучитьСтавкуНДС(ТекСтрока.Номенклатура);
	
	ПересчетТЧ(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)    
	ПересчитатьВсеСтроки();
КонецПроцедуры    

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
    // Если табличная часть пустая — выходим
    Если Объект.ТабНоменклатура.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    // Пересчитываем все строки
    ПересчитатьВсеСтроки();
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если Объект.Ссылка = ПредопределенноеЗначение("Документ.ПеремещениеТоваров.ПустаяСсылка") Тогда
        Если НЕ ЗначениеЗаполнено(Объект.Дата) Тогда
            Объект.Дата = ТекущаяДата();
        КонецЕсли;
        
        Объект.Комментарий = "Перемещение товаров от " + Формат(Объект.Дата, "ДЛФ=D");
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	ПечатьНакладнойНаСервере();
КонецПроцедуры

&НаСервере
Функция ПечатьНакладнойНаСервере()
    ТабДок = Новый ТабличныйДокумент;
    Макет = Документы.ПеремещениеТоваров.ПолучитьМакет("НакладнаяПеремещения");
    
    // Заголовок
    ТабДок.Вывести(Макет.ПолучитьОбласть("Заголовок"));
    
    // Шапка
    ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
    ОбластьШапка.Параметры.Номер = Объект.Номер;
    ОбластьШапка.Параметры.Дата = Формат(Объект.Дата, "ДЛФ=D");
    ОбластьШапка.Параметры.Организация = Объект.Организация;
    ОбластьШапка.Параметры.СкладОтправитель = Объект.СкладОтправитель;
    ОбластьШапка.Параметры.СкладПолучатель = Объект.СкладПолучатель;
    ТабДок.Вывести(ОбластьШапка);
    
    // Заголовки таблицы
    ТабДок.Вывести(Макет.ПолучитьОбласть("ТабНоменклатураШапка"));
    
    // Строки таблицы
	ОбластьСтрока = Макет.ПолучитьОбласть("ТабНоменклатура");
    НомерСтроки = 0;
    Для Каждого ТекСтрока Из Объект.ТабНоменклатура Цикл
        НомерСтроки = НомерСтроки + 1;
        ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
        ОбластьСтрока.Параметры.Номенклатура = ТекСтрока.Номенклатура;
        ОбластьСтрока.Параметры.ВидНоменклатуры = ТекСтрока.ВидНоменклатуры;
        ОбластьСтрока.Параметры.ЕдиницаИзмерения = ТекСтрока.ЕдиницаИзмерения;
        ОбластьСтрока.Параметры.Количество = ТекСтрока.Количество;
        ОбластьСтрока.Параметры.Цена = ТекСтрока.Цена;
        ОбластьСтрока.Параметры.СтавкаНДС = ТекСтрока.СтавкаНДС;
        ОбластьСтрока.Параметры.СуммаНДС = ТекСтрока.СуммаНДС;
        ОбластьСтрока.Параметры.Сумма = ТекСтрока.Сумма;
        ТабДок.Вывести(ОбластьСтрока);
    КонецЦикла;
    
    // Подвал
    ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
    ОбластьПодвал.Параметры.СуммаИтого = Объект.СуммаИтого;
    ТабДок.Вывести(ОбластьПодвал);
    
    Возврат ТабДок;
КонецФункции

&НаКлиенте
Процедура ПечатьНакладной(Команда)
    ТабДок = ПечатьНакладнойНаСервере();
    ТабДок.Показать("Накладная на перемещение");
КонецПроцедуры