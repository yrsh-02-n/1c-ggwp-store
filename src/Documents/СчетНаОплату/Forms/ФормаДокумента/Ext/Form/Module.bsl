&НаКлиенте
Процедура ПересчетТЧ(Элемент)
    ТекСтрока = Элементы.ТабНоменклатура.ТекущиеДанные;
    Если ТекСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    РаботаСТабличнымиЧастями.РассчитатьСтрокуТовары(ТекСтрока);
    ПересчитатьИтогиИПропись();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьВсеСтроки()
    Для каждого Строка Из Объект.ТабНоменклатура Цикл
        // Пересчитываем цену
        Если ЗначениеЗаполнено(Строка.Номенклатура) Тогда
            Строка.Цена = РаботаСЦеной.ЦенаПродажи(
                Объект.Дата,
                Объект.Организация,
                Строка.Номенклатура
            );
        КонецЕсли;
        
        // Подтягиваем ставку
        Если НЕ ЗначениеЗаполнено(Строка.СтавкаНДС) И ЗначениеЗаполнено(Строка.Номенклатура) Тогда
            Строка.СтавкаНДС = РаботаСНДС.ПолучитьСтавкуНДС(Строка.Номенклатура);
        КонецЕсли;
        
        // Считаем строку
        РаботаСТабличнымиЧастями.РассчитатьСтрокуТовары(Строка);
    КонецЦикла;
    
    ПересчитатьИтогиИПропись();
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИтогиИПропись()
    Итоги = РаботаСТабличнымиЧастями.ПолучитьИтогиПоДокументу(Объект.ТабНоменклатура);
    Объект.СуммаИтого = Итоги.СуммаИтого;
    Объект.СуммаНДСИтого = Итоги.СуммаНДСИтого;
    
    СуммаИтогоПрописью = ИтогИСумма.ИтоговоеЧислоПрописью(Объект.СуммаИтого);
КонецПроцедуры 

&НаСервере
Функция ПолучениеЕдиницаИзмерения(Номенклатура)
	Возврат Номенклатура.ЕдиницаИзмерения;
КонецФункции

&НаСервере
Функция ПолучениеВидНоменклатуры(Номенклатура)
	Возврат Номенклатура.ВидНоменклатуры;
КонецФункции

&НаКлиенте
Процедура ТабНоменклатураНоменклатураПриИзменении(Элемент) 
    ТекСтрока = Элементы.ТабНоменклатура.ТекущиеДанные;
    Если ТекСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ТекСтрока.ЕдиницаИзмерения = ПолучениеЕдиницаИзмерения(ТекСтрока.Номенклатура); 
    ТекСтрока.ВидНоменклатуры = ПолучениеВидНоменклатуры(ТекСтрока.Номенклатура);
    ТекСтрока.Цена = РаботаСЦеной.ЦенаПродажи(Объект.Дата, Объект.Организация, ТекСтрока.Номенклатура);
    ТекСтрока.СтавкаНДС = РаботаСНДС.ПолучитьСтавкуНДС(ТекСтрока.Номенклатура);
    
    ПересчетТЧ(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)    
	ПересчитатьВсеСтроки();
КонецПроцедуры 

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
    // Если табличная часть пустая — выходим
    Если Объект.ТабНоменклатура.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    // Пересчитываем все строки
    ПересчитатьВсеСтроки();
КонецПроцедуры


// Проверка типа контрагента
&НаКлиенте
Процедура КонтрагентПриИзменении(Элемент)
	Если НЕ ПроверкаКонтрагента(Объект.Контрагент) Тогда
		ТекстСообщения = "Выбранный контрагент не является покупателем.
		|Очистить поле ""Контрагент?""";
		Режим = РежимДиалогаВопрос.ДаНетОтмена;
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтотОбъект, Параметры);
		ПоказатьВопрос(Оповещение, ТекстСообщения, Режим);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.Контрагент = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверкаКонтрагента(ТекущийКонтрагент)
	Возврат ТекущийКонтрагент.Покупатель;
КонецФункции

